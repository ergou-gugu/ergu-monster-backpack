# ============================================================
#  换行策略
#  仓库里一律存 LF;检出文本时也保持 LF(跨平台 + CI 友好)
# ============================================================
* text=auto eol=lf

# ---- 例外 1:Windows 批处理必须 CRLF ----
# cmd.exe 解析 LF 换行的 .bat 时,goto / label 会出错
*.bat           text eol=crlf
*.cmd           text eol=crlf

# ---- 例外 2:Gradle 的 Linux 启动脚本必须 LF ----
/gradlew        text eol=lf

# ---- 二进制文件:禁止任何换行转换 ----
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.jar  binary
*.zip  binary
*.ogg  binary
*.nbt  binary
